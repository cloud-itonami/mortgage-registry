;; Portable `.cljc` catalog. The test suite and the tx-data generator run under
;; nbb (script-host policy: nbb only, ADR-2607173000):
;;
;;   kbb --backend sci --classpath src:test run-tests.cljs
;;   kbb --backend sci --classpath src scripts/emit_tx.cljs
;;
;; This deps.edn exists so the same `.cljc` sources load on a JVM classpath for
;; linting and for consumers that embed the catalog in a Datomic/DataScript
;; process. There is no JVM-only code in this repository.
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "4bf68e1a1b205674c70f386d59e430801fae3572"
         :deps/root "lib/kotoba.text"}}
 :aliases
 {:lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
